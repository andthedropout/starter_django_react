#!/usr/bin/env bash
# First-run setup: create .env if missing, start the dev stack, migrate.
# Safe to re-run: it never rewrites .env, never drops volumes, never seeds users.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! docker info >/dev/null 2>&1; then
  echo "Docker does not appear to be running. Start Docker and try again." >&2
  exit 1
fi

if [ -f .env ]; then
  echo "==> .env exists, leaving it untouched"
else
  cp .env.example .env
  echo "==> Created .env from .env.example"
  echo "    Review PROJECT_NAME, SECRET_KEY and the POSTGRES_* values before deploying."
fi

echo "==> Building and starting postgres, web and js"
docker compose up -d --build

echo "==> Applying migrations"
docker compose run --rm web python manage.py migrate --noinput

cat <<'EOF'

Setup complete.

  App:                    use the VITE_PORT configured in .env (default 5173)
  Django:                 use the WEB_PORT configured in .env (default 8000)
  Logs:                   docker compose logs -f
  Stop:                   docker compose down

Create an admin user when you need one:

  docker compose exec web python manage.py createsuperuser
EOF

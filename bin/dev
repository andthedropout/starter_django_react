#!/usr/bin/env bash
# Thin wrapper around docker compose for the development stack.
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage: bin/dev <command> [args...]

  up [svc...]        start the stack in the background (build if needed)
  down [args...]     stop the stack (volumes are kept)
  build [svc...]     rebuild images
  restart [svc...]   restart services
  logs [svc...]      follow logs
  shell [svc]        interactive shell in a service (default: web)
  manage <args...>   run manage.py inside the running web container
  migrate            apply migrations in a one-off container
EOF
}

command="${1:-}"
[ $# -gt 0 ] && shift

case "${command}" in
  up)      exec docker compose up -d --build "$@" ;;
  down)    exec docker compose down "$@" ;;
  build)   exec docker compose build "$@" ;;
  restart) exec docker compose restart "$@" ;;
  logs)    exec docker compose logs -f "$@" ;;
  shell)   exec docker compose exec "${1:-web}" bash ;;
  manage)  exec docker compose exec web python manage.py "$@" ;;
  migrate) exec docker compose run --rm web python manage.py migrate --noinput ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: ${command}" >&2; usage >&2; exit 1 ;;
esac

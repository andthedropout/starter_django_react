# Keep the build context to what the images actually need:
# pyproject.toml, uv.lock, backend/, frontend/ (sources + bun.lock).

# Secrets and local config
.env
.env.*
!.env.example

# VCS and tooling metadata
.git
.gitignore
.gitattributes
.github/
.claude/
.vscode/
.idea/

# Docs (not needed at runtime)
*.md
docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tests are not shipped in the runtime image
**/tests/
**/test_*.py
**/conftest.py

# Node / frontend build artifacts (dist is rebuilt inside the image)
**/node_modules/
frontend/dist/
frontend/.vite/
.vite-cache/

# Django outputs and user data
staticfiles/
public_collected/
media/
*.sqlite3

# Local noise
*.log
.DS_Store
._*
Thumbs.db
*.bak
*.tmp

# Set a unique name before the first startup of each template copy.
# Do not rename an existing project without a deliberate database migration.
PROJECT_NAME=starter_django_react
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# Local development only. Production requires a fresh random secret and DEBUG=false.
DEBUG=true
SECRET_KEY=development-only-change-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_PORT=8000
VITE_PORT=5173
SITE_URL=http://localhost:5173

POSTGRES_USER=${PROJECT_NAME}
POSTGRES_DB=${PROJECT_NAME}
POSTGRES_PASSWORD=development-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Production: set DATABASE_URL to the provider's PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional production tuning; start small and measure before increasing.
# WEB_CONCURRENCY=1
# WEB_THREADS=2
# DOMAIN=app.example.com
# ACME_EMAIL=you@example.com
# TRUST_PROXY_HEADERS=true

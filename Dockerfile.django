# syntax=docker/dockerfile:1.7
#
# Django images only — the frontend lives in Dockerfile.frontend.
#
# Targets:
#
#   python-deps   locked Python virtualenv at /app/.venv (build only)
#   development   Django + dev dependency groups, runserver, no frontend build
#   runtime       production Django: venv + backend + collected admin static (default)
#
#   docker build -f Dockerfile.django -t app-web .
#
# The dev image is built by compose (target `development`).

###############################################################################
# Python base — uv pinned, shared by the dependency builder and the dev image
###############################################################################
FROM python:3.13-slim-bookworm AS python-base

# uv is pinned exactly and copied as a single static binary (no pip layer).
COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    DJANGO_SETTINGS_MODULE=config.settings \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

###############################################################################
# Python dependencies — runtime only, resolved from uv.lock
###############################################################################
FROM python-base AS python-deps

COPY pyproject.toml uv.lock ./

RUN uv sync --locked --no-dev --no-install-project

###############################################################################
# Development Django image — dependency groups included, no frontend build
###############################################################################
FROM python-base AS development

COPY pyproject.toml uv.lock ./

RUN uv sync --locked --no-install-project

# Source is bind-mounted at /app/backend by compose; nothing is baked in.
WORKDIR /app/backend

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

###############################################################################
# Production runtime (default target) — Django only: venv, backend, own static
###############################################################################
FROM python:3.13-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/backend \
    DJANGO_SETTINGS_MODULE=config.settings \
    STATIC_ROOT=/app/staticfiles \
    PATH=/app/.venv/bin:$PATH

RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && mkdir -p /app/staticfiles \
    && chown -R app:app /app

WORKDIR /app

COPY --from=python-deps --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app backend/ /app/backend/

USER app

# Only Django's own static (admin, DRF) is collected: the SPA assets are served
# by the Bun frontend runtime. The dummy values below are build-time only and
# collectstatic never touches a database.
RUN SECRET_KEY="build-only-not-a-secret" \
    DEBUG=false \
    ALLOWED_HOSTS="*" \
    DATABASE_URL="postgres://build:build@127.0.0.1:5432/build" \
    python /app/backend/manage.py collectstatic --no-input

EXPOSE 8000

# Migrations are an explicit release step (Railway preDeployCommand / compose run),
# never a container-start side effect.
CMD ["gunicorn", "-c", "python:config.gunicorn", "--chdir", "/app/backend", "config.wsgi:application"]
